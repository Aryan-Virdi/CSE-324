# -------------------------------------------------------------------------------
# 1. COPY this file to a new file named '.env'
# 2. To reset the DB with new credentials: 'docker compose down -v && docker compose up -d'
# -------------------------------------------------------------------------------

# Individual variables (Used by Docker to build the database)
DB_USER=admin
DB_PASSWORD=password123
DB_NAME=central_db

# Connection String (Used by Python/SQLModel to talk to the database)
# NOTE: If you change the user or password above, you MUST update them here too!
DATABASE_URL=postgresql://admin:password123@db:5432/central_db

# -------------------------------------------------------------------------------
# MinIO Object Storage Configuration
# -------------------------------------------------------------------------------

# MinIO root credentials (for the MinIO container itself)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

# Endpoint URL
EXTERNAL_ENDPOINT=http://minio:9000

# AWS credentials for S3 or MinIO authentication (used by the Python app)
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123

# S3/MinIO bucket name for storing processed images
IMAGES_BUCKET=processed-images

# AWS region (used for AWS S3, dummy value for MinIO)
AWS_DEFAULT_REGION=us-west-1
